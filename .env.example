# Public Firebase web-app configuration (Firebase console > Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# PRIVATE server variables. Set in Netlify UI; never prefix these with NEXT_PUBLIC_.
# Full service account JSON on one line, including escaped \n in private_key.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase Authentication UID of the studio owner; no first-user auto-admin.
ADMIN_UID=
# Exact Netlify/site URL, without a trailing slash. Use http://localhost:3000 locally.
APP_ORIGIN=
# Optional AI service; keep empty to leave AI editing disabled.
OPENAI_API_KEY=
# Gateway ব্যবহার করলে তার base URL (খালি রাখলে OpenAI সরাসরি)। /images/edits endpoint সমর্থিত হতে হবে।
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional AI document model (server only)
OPENAI_TEXT_MODEL=gpt-4.1-mini
